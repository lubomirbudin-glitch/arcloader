<Window x:Class="Offload.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Offload.App"
        Title="{Binding WindowTitle}" Width="1240" Height="860" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Offload.ico">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding StartCommand}" />
        <KeyBinding Gesture="Ctrl+U" Command="{Binding OpenHardwareCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding VerifyBackupCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
          <DockPanel>
            <!-- Spec 4.4: a quiet link when the manifest names a newer version. -->
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                       Visibility="{Binding NewVersionText, Converter={StaticResource NullToCollapsed}}">
                <Hyperlink Command="{Binding UpdatesCommand}" AutomationProperties.AutomationId="NewVersionLink">
                    <Run Text="{Binding NewVersionText, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
            <Menu Padding="6,2">
                <!-- Ruling I1: off while Start checks and asks (CanSwitchProject) -->
                <MenuItem Header="_Projekt" IsEnabled="{Binding CanSwitchProject}" AutomationProperties.AutomationId="ProjectMenu">
                    <MenuItem Header="Uložit jako projekt…" Command="{Binding SaveAsProjectCommand}"
                              AutomationProperties.AutomationId="SaveAsProjectMenuItem" />
                    <MenuItem Header="Přejmenovat…" Command="{Binding RenameProjectCommand}"
                              AutomationProperties.AutomationId="RenameProjectMenuItem" />
                    <MenuItem Header="Smazat…" Command="{Binding DeleteProjectCommand}"
                              AutomationProperties.AutomationId="DeleteProjectMenuItem" />
                </MenuItem>
                <MenuItem Header="_Nástroje">
                    <MenuItem Header="Ověřit zálohu…" InputGestureText="Ctrl+Shift+O" Command="{Binding VerifyBackupCommand}"
                              AutomationProperties.AutomationId="VerifyBackupMenuItem">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE9D5;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Ukládat report ověření" IsCheckable="True" IsChecked="{Binding SaveVerifyReport}"
                              AutomationProperties.AutomationId="SaveVerifyReportMenuItem" />
                    <MenuItem Header="Oznámení…" Command="{Binding NotifySettingsCommand}" AutomationProperties.AutomationId="NotifyMenuItem" />
                    <MenuItem Header="Aktualizace…" Command="{Binding UpdatesCommand}" AutomationProperties.AutomationId="UpdatesMenuItem" />
                    <MenuItem Header="Denní report…" Command="{Binding DayReportCommand}"
                              AutomationProperties.AutomationId="DayReportMenuItem">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8A5;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Prověřit USB porty…" InputGestureText="Ctrl+U" Command="{Binding OpenHardwareCommand}"
                              AutomationProperties.AutomationId="CheckPortsMenuItem">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE88E;" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
          </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="360" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>
            <local:SetupPanel Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <local:QueuePanel Grid.Column="2" />
        </Grid>
    </DockPanel>
</Window>
