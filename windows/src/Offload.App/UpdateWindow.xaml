<Window x:Class="Offload.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updates" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Offload.ico">
    <StackPanel Margin="22,18">
        <TextBlock Text="Updates" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="Current" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        <TextBlock Text="Manifest address (web, NAS or shared folder)" Style="{StaticResource Caption}" Margin="0,12,0,4" />
        <TextBox Text="{Binding UpdateManifest, UpdateSourceTrigger=LostFocus}" x:Name="Manifest" AutomationProperties.AutomationId="UpdateManifest"
                 AutomationProperties.Name="Manifest address" />
        <TextBlock Text="Offload only checks whether there is a new version — it never downloads or runs anything. Empty = check off."
                   Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CheckButton" Content="Check now" Click="Check_Click" Padding="12,5" AutomationProperties.AutomationId="UpdateCheckNow" />
            <TextBlock x:Name="Result" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="320"
                       AutomationProperties.AutomationId="UpdateResult" />
        </StackPanel>
        <Border Margin="0,14,0,0" Padding="12" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding NewVersionText, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <TextBlock Text="{Binding NewVersionText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding NewVersion.Notes}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <!-- Ruling I5: the address is plain text, never a link; "Open" only for https or an existing folder / zip. -->
                <TextBox Text="{Binding NewVersion.Url, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                         TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="UpdateUrl" />
                <TextBlock Text="{Binding NewVersionNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding NewVersionNote, Converter={StaticResource NullToCollapsed}}" AutomationProperties.AutomationId="UpdateNote" />
                <Button Content="Open" Click="Open_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5"
                        IsEnabled="{Binding NewVersionCanOpen}" AutomationProperties.AutomationId="UpdateOpen" />
            </StackPanel>
        </Border>
        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="80" Padding="12,5" Margin="0,20,0,0" />
    </StackPanel>
</Window>
