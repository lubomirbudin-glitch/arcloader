<UserControl x:Class="Offload.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Offload.Core.Desktop;assembly=Offload.Core">
    <!-- Project settings (UI design fig. 4): every option that is not in step 3's summary. Edits the profile shown, like
         the left panel did; "Done" and "‹ Back" only close the page (changes are saved as they are made). -->
    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource Bg}">
        <!-- ‹ Back · Project <name> · … · Save as new project · Done -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding CloseSettingsCommand}" Padding="10,0"
                        AutomationProperties.AutomationId="SettingsBackButton">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconLine}" Content="{StaticResource IconBack}" Tag="2" Margin="0,0,6,0"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Left" Width="1" Height="22" Background="{DynamicResource Line}" Margin="14,0" />
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Project" FontSize="12" Foreground="{DynamicResource Text3}" />
                    <TextBlock Text="{Binding ProjectLabel}" FontWeight="SemiBold" AutomationProperties.AutomationId="SettingsProjectName" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="34" FontSize="13" Padding="16,0" Content="Done"
                        Command="{Binding CloseSettingsCommand}" AutomationProperties.AutomationId="SettingsDoneButton" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Save as new project…" Margin="0,0,8,0"
                        Command="{Binding SaveAsProjectCommand}" AutomationProperties.AutomationId="SettingsSaveAsProjectButton" />
                <Border />
            </DockPanel>
        </Border>
        <!-- Sections -->
        <Border DockPanel.Dock="Left" Width="240" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="14,20">
            <StackPanel>
                <RadioButton Style="{StaticResource NavButton}" Content="Folder structure" AutomationProperties.AutomationId="NavFolders"
                             IsChecked="{Binding SettingsSection, Converter={StaticResource Equals}, ConverterParameter=folders}" />
                <RadioButton Style="{StaticResource NavButton}" Content="Verification" AutomationProperties.AutomationId="NavVerify"
                             IsChecked="{Binding SettingsSection, Converter={StaticResource Equals}, ConverterParameter=verify}" />
                <RadioButton Style="{StaticResource NavButton}" Content="Analysis and thumbnails" AutomationProperties.AutomationId="NavAnalysis"
                             IsChecked="{Binding SettingsSection, Converter={StaticResource Equals}, ConverterParameter=analysis}" />
                <RadioButton Style="{StaticResource NavButton}" Content="Proxies" AutomationProperties.AutomationId="NavProxy"
                             IsChecked="{Binding SettingsSection, Converter={StaticResource Equals}, ConverterParameter=proxy}" />
                <RadioButton Style="{StaticResource NavButton}" Content="Report" AutomationProperties.AutomationId="NavReport"
                             IsChecked="{Binding SettingsSection, Converter={StaticResource Equals}, ConverterParameter=report}" />
                <RadioButton Style="{StaticResource NavButton}" Content="Notifications" AutomationProperties.AutomationId="NavNotify"
                             IsChecked="{Binding SettingsSection, Converter={StaticResource Equals}, ConverterParameter=notify}" />
                <RadioButton Style="{StaticResource NavButton}" Content="RAW decoders" AutomationProperties.AutomationId="NavDecoders"
                             IsChecked="{Binding SettingsSection, Converter={StaticResource Equals}, ConverterParameter=decoders}" />
                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="12,10" />
                <RadioButton Style="{StaticResource NavButton}" Content="App" AutomationProperties.AutomationId="NavApp"
                             IsChecked="{Binding SettingsSection, Converter={StaticResource Equals}, ConverterParameter=app}" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,26,32,32">

                <!-- ── Folder structure ── -->
                <StackPanel Style="{StaticResource Section}" Visibility="{Binding SettingsSection, Converter={StaticResource EqualsToVisible}, ConverterParameter=folders}">
                    <TextBlock Text="Folder structure" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Where the card is written on a destination: &lt;destination&gt;\&lt;date&gt;\&lt;card name&gt;\." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,4,0,26" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Path" Style="{StaticResource RowLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding PathPreview}" Style="{StaticResource TextMono}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Date" Style="{StaticResource RowLabel}" Margin="0,16,18,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                            <CheckBox Style="{StaticResource Check}" Content="Custom date" IsChecked="{Binding UseCustomDate}" AutomationProperties.AutomationId="UseCustomDate" />
                            <DatePicker SelectedDate="{Binding CustomDate}" Margin="14,0,0,0" Width="150"
                                        Visibility="{Binding UseCustomDate, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Card name" Style="{StaticResource RowLabel}" Margin="0,16,18,0" />
                        <CheckBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Check}" Margin="0,16,0,0" Content="Suggest the card name from the clips"
                                  IsChecked="{Binding SuggestCardNames}" AutomationProperties.AutomationId="SuggestCardNames" />
                    </Grid>
                    <!-- Automatic disk pick-up (2026-10-09): per project, like everything on this page -->
                    <TextBlock Text="CONNECTED DISKS" Style="{StaticResource StepTitle}" Margin="0,30,0,10" />
                    <CheckBox Style="{StaticResource Check}" Content="{x:Static core:SettingsTexts.AutoDestinationsLabel}" IsChecked="{Binding AutoAddDestinations}"
                              AutomationProperties.AutomationId="AutoAddDestinations" />
                    <TextBlock Text="{x:Static core:SettingsTexts.AutoDestinationsNote}" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="26,4,0,0" />
                    <CheckBox Style="{StaticResource Check}" Content="{x:Static core:SettingsTexts.AutoCardsLabel}" IsChecked="{Binding AutoAddCards}" Margin="0,14,0,0"
                              AutomationProperties.AutomationId="AutoAddCards" />
                    <TextBlock Text="{x:Static core:SettingsTexts.AutoCardsNote}" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="26,4,0,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding ForgetRemovedText}" Command="{Binding ForgetRemovedDisksCommand}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Visibility="{Binding ForgetRemovedText, Converter={StaticResource NullToCollapsed}}"
                            AutomationProperties.AutomationId="ForgetRemovedDisks" />
                </StackPanel>

                <!-- ── Verification ── -->
                <StackPanel Style="{StaticResource Section}" Visibility="{Binding SettingsSection, Converter={StaticResource EqualsToVisible}, ConverterParameter=verify}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="On" IsChecked="{Binding Verify}" VerticalAlignment="Top"
                                  AutomationProperties.AutomationId="VerifySwitch" />
                        <StackPanel>
                            <TextBlock Text="Verification" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Every file is read back from the disk after writing and compared with the card." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{x:Static core:SetupTexts.VerifyOffWarning}" Style="{StaticResource TextWarn}" Margin="0,12,0,0"
                               Visibility="{Binding Verify, Converter={StaticResource BoolToCollapsed}}" />
                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Checksum" Style="{StaticResource RowLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding HashChoices}" SelectedItem="{Binding Hash}" DisplayMemberPath="Label" HorizontalAlignment="Left"
                                  MinWidth="200" AutomationProperties.AutomationId="HashChoice" />
                    </Grid>
                    <TextBlock Text="{Binding Md5Note}" Style="{StaticResource TextWarn}" Margin="138,8,0,0" Visibility="{Binding Md5Note, Converter={StaticResource NullToCollapsed}}" />
                    <!-- Plan 10 (R11): verify the primary disk while the proxies are made; the others in the background. -->
                    <CheckBox Style="{StaticResource Check}" Content="{x:Static core:SettingsTexts.VerifyInProxyLabel}" IsChecked="{Binding VerifyInProxy}" Margin="0,22,0,0"
                              IsEnabled="{Binding Verify}" AutomationProperties.AutomationId="VerifyInProxy" />
                    <TextBlock Text="{x:Static core:SettingsTexts.VerifyInProxyNote}" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="26,4,0,0" />
                    <CheckBox Style="{StaticResource Check}" Content="{x:Static core:SettingsTexts.VerifyPrimaryFirstLabel}" IsChecked="{Binding VerifyPrimaryFirst}" Margin="26,10,0,0"
                              IsEnabled="{Binding VerifyInProxy}" AutomationProperties.AutomationId="VerifyPrimaryFirst" />
                    <TextBlock Text="VERIFY BACKUP" Style="{StaticResource StepTitle}" Margin="0,30,0,10" />
                    <TextBlock Text="Checks an earlier backup on a destination against its ASC MHL, without the card (Ctrl+Shift+O)." Style="{StaticResource TextMuted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Verify backup…" Command="{Binding VerifyBackupCommand}" />
                        <CheckBox Style="{StaticResource Check}" Content="Save a verification report" IsChecked="{Binding SaveVerifyReport}" Margin="18,0,0,0"
                                  AutomationProperties.AutomationId="SaveVerifyReport" />
                    </StackPanel>
                </StackPanel>

                <!-- ── Analysis and thumbnails ── -->
                <StackPanel Style="{StaticResource Section}" Visibility="{Binding SettingsSection, Converter={StaticResource EqualsToVisible}, ConverterParameter=analysis}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="On" IsChecked="{Binding AnalyzeClips}" VerticalAlignment="Top"
                                  AutomationProperties.AutomationId="AnalyzeSwitch" />
                        <StackPanel>
                            <TextBlock Text="Analysis and thumbnails" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="After verification the clips are analysed and the report gets 3 frames from every clip (start, middle, end)." Style="{StaticResource TextMuted}"
                                       FontSize="14" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ToolsWarning}" Style="{StaticResource TextWarn}" Margin="0,16,0,0"
                               Visibility="{Binding ToolsWarning, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <!-- ── Proxies (fig. 4) ── -->
                <WrapPanel Visibility="{Binding SettingsSection, Converter={StaticResource EqualsToVisible}, ConverterParameter=proxy}" Orientation="Horizontal">
                    <StackPanel Width="560" Margin="0,0,32,0" DataContext="{Binding Proxy}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="On" IsChecked="{Binding Enabled}" VerticalAlignment="Top"
                                      AutomationProperties.AutomationId="ProxySwitch" />
                            <StackPanel>
                                <TextBlock Text="Proxies" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Rendered only after verification — the originals always come first." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Codec" Style="{StaticResource RowLabel}" />
                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                <ItemsControl ItemsSource="{Binding CodecChoices}" AutomationProperties.AutomationId="CodecChoice">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding Label}" IsChecked="{Binding IsSelected}" GroupName="Codec" Margin="0,0,4,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource RowLabel}" Margin="0,16,18,0" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding HeightChoices}" AutomationProperties.AutomationId="HeightChoice">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding Label}" IsChecked="{Binding IsSelected}" GroupName="Height" Margin="0,0,4,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Grid.Row="2" Text="Bitrate" Style="{StaticResource RowLabel}" Margin="0,16,18,0"
                                       Visibility="{Binding ShowBitrate, Converter={StaticResource BoolToVisible}}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding ShowBitrate, Converter={StaticResource BoolToVisible}}">
                                <Border CornerRadius="8" BorderBrush="{DynamicResource LineInput}" BorderThickness="1" Background="{DynamicResource Input}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="−" FontSize="16" Command="{Binding BitrateDownCommand}"
                                                AutomationProperties.Name="Lower bitrate" />
                                        <TextBlock Text="{Binding BitrateText}" Style="{StaticResource TextMono}" Foreground="{DynamicResource Text}" Margin="10,0" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Content="+" FontSize="16" Command="{Binding BitrateUpCommand}"
                                                AutomationProperties.Name="Raise bitrate" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding BitrateHint}" Style="{StaticResource TextFaint}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Crop" Style="{StaticResource RowLabel}" Margin="0,16,18,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                                <ComboBox ItemsSource="{Binding Aspects}" SelectedItem="{Binding Aspect}" DisplayMemberPath="Label" Width="130"
                                          ToolTip="Crop to frame lines (aspect ratio)" AutomationProperties.AutomationId="AspectChoice" />
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Visibility="{Binding ShowFrameScale, Converter={StaticResource BoolToVisible}}"
                                            ToolTip="Frame line size relative to the image – 90% = 10% overscan">
                                    <Button Style="{StaticResource IconButton}" Content="−" FontSize="16" Command="{Binding ScaleDownCommand}" />
                                    <TextBlock Text="{Binding ScaleText}" Width="90" TextAlignment="Center" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconButton}" Content="+" FontSize="16" Command="{Binding ScaleUpCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- LUT by camera -->
                        <DockPanel Margin="0,26,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Custom .cube…" Command="{Binding PickLutCommand}"
                                    AutomationProperties.AutomationId="PickLutButton" />
                            <TextBlock Text="LUT BY CAMERA" Style="{StaticResource StepTitle}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="LUT" Style="{StaticResource RowLabel}" Width="120" Margin="0" />
                            <ComboBox ItemsSource="{Binding LutChoices}" SelectedItem="{Binding LutChoice}" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="260"
                                      AutomationProperties.AutomationId="LutChoice" />
                        </DockPanel>
                        <Border Style="{StaticResource ListBorder}" Margin="0,12,0,0" Visibility="{Binding LutRows.Count, Converter={StaticResource CountToVisible}}">
                            <ItemsControl ItemsSource="{Binding LutRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Marker, Converter={StaticResource IsNull}}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoft2}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="13" />
                                                <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis" Margin="12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Marker}" FontSize="13" Foreground="{DynamicResource AccentText}" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <DockPanel Margin="0,12,0,0" Visibility="{Binding ShowFallback, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="If the camera is not recognised:" Style="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding FallbackChoices}" SelectedItem="{Binding Fallback}" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="200"
                                      AutomationProperties.AutomationId="LutFallbackChoice" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding ShowCustom, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Custom LUT:" Style="{StaticResource TextMuted}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding LutName}" Style="{StaticResource TextMono}" ToolTip="{Binding LutPath}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding RulesButtonText}" Command="{Binding EditRulesCommand}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" ToolTip="Custom order: camera / serial number / reel / folder → LUT"
                                Visibility="{Binding ShowRules, Converter={StaticResource BoolToVisible}}" AutomationProperties.AutomationId="LutRulesButton" />

                        <!-- More -->
                        <TextBlock Text="MORE" Style="{StaticResource StepTitle}" Margin="0,26,0,10" />
                        <CheckBox Style="{StaticResource Check}" Content="Audio in proxies" IsChecked="{Binding Audio}" Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource Check}" Content="Skip proxies recorded by the camera (SUB / PROXY)" IsChecked="{Binding SkipCameraProxies}" Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource Check}" Content="No proxy when the original is lighter (H.264/HEVC proxies only)" IsChecked="{Binding SkipLighterSources}" Margin="0,0,0,10"
                                  ToolTip="Only for H.264/HEVC proxies and only when no LUT or crop is applied: an H.264 or HEVC original that is not larger than the proxy and has no higher bitrate is not transcoded — the proxy would be as large or larger. With ProRes proxies and for ProRes, DNx and RAW originals a proxy is always made."
                                  AutomationProperties.AutomationId="SkipLighterSources" />
                        <CheckBox Style="{StaticResource Check}" Content="Hardware decoding (experimental)" IsChecked="{Binding HardwareDecode}" Margin="0,0,0,10"
                                  ToolTip="H.264 and HEVC originals are decoded by the graphics card. Off: the CPU decodes — on the Mac, hardware decoding sometimes returned a green frame without any error. Proxy encoding always runs on the graphics card."
                                  AutomationProperties.AutomationId="HardwareDecode" />
                        <CheckBox Style="{StaticResource Check}" Content="Copy proxies to all destinations" IsChecked="{Binding CopyToAllDestinations}" Margin="0,0,0,10" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Also copy proxies to a folder" Style="{StaticResource TextMuted}" VerticalAlignment="Center" Width="200" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Command="{Binding ClearFolderCommand}" ToolTip="Do not copy to a folder"
                                    Visibility="{Binding HasExtraFolder, Converter={StaticResource BoolToVisible}}"
                                    AutomationProperties.AutomationId="ProxyFolderClearButton" AutomationProperties.Name="Do not copy to a folder">
                                <ContentControl Style="{StaticResource IconLine}" Content="{StaticResource IconClose}" Width="14" Height="14" Tag="2"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Choose…" Command="{Binding PickFolderCommand}" Margin="8,0"
                                    AutomationProperties.AutomationId="ProxyFolderButton" />
                            <TextBlock Text="{Binding ExtraFolderName}" ToolTip="{Binding ExtraFolderPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Why a start is blocked or what is skipped (the window's checks, not the proxy settings themselves). -->
                        <TextBlock Text="{Binding DataContext.LutProblem, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource TextDanger}" Margin="0,16,0,0"
                                   Visibility="{Binding DataContext.LutProblem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding DataContext.ProxyFolderProblem, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource TextDanger}" Margin="0,8,0,0"
                                   Visibility="{Binding DataContext.ProxyFolderProblem, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding DataContext.ToolsWarning, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource TextWarn}" Margin="0,8,0,0"
                                   Visibility="{Binding DataContext.ToolsWarning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- Burn-in preview: a grey 16:9 frame (decision: no real frame yet) -->
                    <StackPanel Width="380" DataContext="{Binding Proxy}">
                        <TextBlock Text="BURN-IN PREVIEW" Style="{StaticResource StepTitle}" Margin="0,4,0,14" />
                        <Border CornerRadius="10" Background="{DynamicResource PreviewBg}" BorderBrush="{DynamicResource LineInput}" BorderThickness="1" ClipToBounds="True">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="384" Height="216">
                                    <TextBlock Text="[frame from the clip]" Foreground="{DynamicResource PreviewText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Grid Visibility="{Binding HasFrame, Converter={StaticResource BoolToVisible}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding FrameLeft}" />
                                            <ColumnDefinition Width="{Binding FrameWidth}" />
                                            <ColumnDefinition Width="{Binding FrameRight}" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding FrameTop}" />
                                            <RowDefinition Height="{Binding FrameHeight}" />
                                            <RowDefinition Height="{Binding FrameBottom}" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource FrameLine}" BorderThickness="1" />
                                    </Grid>
                                    <Border Background="{DynamicResource Shade}" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="25,0,0,17"
                                            Visibility="{Binding BurnFilename, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="A035C010_261007_R2KQ" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <Border Background="{DynamicResource Shade}" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,17"
                                            Visibility="{Binding BurnTimecode, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="14:22:07:13" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Viewbox>
                        </Border>
                        <Border CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14,6" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,9">
                                    <TextBlock DockPanel.Dock="Right" Text="bottom left" Style="{StaticResource TextFaint}" VerticalAlignment="Center" />
                                    <CheckBox Style="{StaticResource Check}" Content="Clip name" IsChecked="{Binding BurnFilename}" AutomationProperties.AutomationId="BurnFilename" />
                                </DockPanel>
                                <Border Height="1" Background="{DynamicResource LineSoft}" />
                                <DockPanel Margin="0,9">
                                    <TextBlock DockPanel.Dock="Right" Text="bottom right" Style="{StaticResource TextFaint}" VerticalAlignment="Center" />
                                    <CheckBox Style="{StaticResource Check}" Content="Timecode" IsChecked="{Binding BurnTimecode}" AutomationProperties.AutomationId="BurnTimecode" />
                                </DockPanel>
                                <Border Height="1" Background="{DynamicResource LineSoft}" />
                                <DockPanel Margin="0,9">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FrameText}" Style="{StaticResource TextMono}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Crop (frame lines)" Margin="28,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Canon Cinema RAW Light and Sony X-OCN are copied and verified; proxies cannot be made for them yet." Style="{StaticResource TextFaint}"
                                   FontSize="13" Margin="0,14,0,0" LineHeight="20" />
                    </StackPanel>
                </WrapPanel>

                <!-- ── Report ── -->
                <StackPanel Style="{StaticResource Section}" Visibility="{Binding SettingsSection, Converter={StaticResource EqualsToVisible}, ConverterParameter=report}">
                    <TextBlock Text="Report" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Always: HTML and PDF in _REPORT, ASC MHL and a checksum list on every destination." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,4,0,26" />
                    <CheckBox Style="{StaticResource Check}" Content="Clip list CSV" IsChecked="{Binding ClipListCsv}" Margin="0,0,0,10" AutomationProperties.AutomationId="ClipListCsv" />
                    <CheckBox Style="{StaticResource Check}" Content="Clip list for Avid (ALE)" IsChecked="{Binding ClipListAle}" Margin="0,0,0,10" AutomationProperties.AutomationId="ClipListAle" />
                    <CheckBox Style="{StaticResource Check}" Content="Day report after every card" IsChecked="{Binding DayReportAfterEachCard}" AutomationProperties.AutomationId="DayReportAfterEachCard" />
                    <!-- task 2026-10-09: a copy of every card's report on this computer -->
                    <TextBlock Text="COPY ON THIS COMPUTER" Style="{StaticResource StepTitle}" Margin="0,30,0,10" />
                    <CheckBox Style="{StaticResource Check}" Content="{x:Static core:SettingsTexts.LocalReportLabel}" IsChecked="{Binding LocalReportCopy}"
                              AutomationProperties.AutomationId="LocalReportCopy" />
                    <TextBlock Text="{x:Static core:SettingsTexts.LocalReportNote}" Style="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="26,4,0,0" />
                    <DockPanel Margin="26,12,0,0" IsEnabled="{Binding LocalReportCopy}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Default" Command="{Binding DefaultLocalReportFolderCommand}" Margin="8,0,0,0"
                                Visibility="{Binding LocalReportFolderCustom, Converter={StaticResource BoolToVisible}}" AutomationProperties.AutomationId="LocalReportFolderDefault" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Change…" Command="{Binding ChooseLocalReportFolderCommand}" Margin="12,0,0,0"
                                AutomationProperties.AutomationId="LocalReportFolderChoose" />
                        <TextBlock Text="{Binding LocalReportFolderText}" Style="{StaticResource TextMono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LocalReportFolderText}" AutomationProperties.AutomationId="LocalReportFolder" />
                    </DockPanel>
                    <TextBlock Text="DAY REPORT" Style="{StaticResource StepTitle}" Margin="0,30,0,10" />
                    <TextBlock Text="Rebuilds the day report of a chosen day folder on a destination and opens it." Style="{StaticResource TextMuted}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Day report…" Command="{Binding DayReportCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            AutomationProperties.AutomationId="DayReportButton" />
                </StackPanel>

                <!-- ── Notifications ── -->
                <StackPanel Style="{StaticResource Section}" Visibility="{Binding SettingsSection, Converter={StaticResource EqualsToVisible}, ConverterParameter=notify}">
                    <TextBlock Text="Notifications" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="When a job ends: a Windows notification (when the window is not in front) and a phone notification via ntfy." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,4,0,26" />
                    <TextBlock Text="{Binding NotifySummary}" AutomationProperties.AutomationId="NotifySummary" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Edit notifications…" Command="{Binding NotifySettingsCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"
                            AutomationProperties.AutomationId="NotifyButton" />
                </StackPanel>

                <!-- ── RAW decoders ── -->
                <StackPanel Style="{StaticResource Section}" Visibility="{Binding SettingsSection, Converter={StaticResource EqualsToVisible}, ConverterParameter=decoders}">
                    <TextBlock Text="RAW decoders" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Tools for proxies and thumbnails. They apply to all projects." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,4,0,26" />
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TileBorder}" Margin="0,0,0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Choose…" Command="{Binding PickCommand}"
                                                ToolTip="Choose the path to the tool" VerticalAlignment="Center" />
                                        <ContentControl Width="16" Height="16" Margin="0,0,12,0">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource IconLine}">
                                                    <Setter Property="Content" Value="{StaticResource IconClose}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Found}" Value="True">
                                                            <Setter Property="Content" Value="{StaticResource IconCheck}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Purpose, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Text2}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding PathText}" Style="{StaticResource TextMonoFaint}" Margin="0,2,0,0" />
                                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                                       Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisible}}">
                                                <Hyperlink Command="{Binding DownloadCommand}" Foreground="{DynamicResource AccentText}"
                                                           ToolTip="{Binding DownloadUrl}" AutomationProperties.Name="Download">
                                                    <Run Text="Download…" />
                                                </Hyperlink>
                                                <Run Text="(maker's page)" Foreground="{DynamicResource Text3}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Canon Cinema RAW Light and Sony X-OCN are copied and verified; proxies cannot be made for them yet." Style="{StaticResource TextFaint}" FontSize="13" Margin="0,4,0,0" />
                    <CheckBox Style="{StaticResource Check}" Content="Convert Blackmagic RAW Film Gen 4 to Gen 5 (the Gen 5 LUT is used)" IsChecked="{Binding Proxy.BrawGen4ToGen5}"
                              Margin="0,18,0,0" AutomationProperties.AutomationId="BrawGen4ToGen5" />
                    <TextBlock Text="not yet confirmed with a Gen 4 .braw sample" Style="{StaticResource TextFaint}" Margin="28,2,0,0" />
                    <TextBlock Text="{Binding ToolsWarning}" Style="{StaticResource TextWarn}" Margin="0,16,0,0" Visibility="{Binding ToolsWarning, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <!-- ── App (global) ── -->
                <StackPanel Style="{StaticResource Section}" Visibility="{Binding SettingsSection, Converter={StaticResource EqualsToVisible}, ConverterParameter=app}">
                    <TextBlock Text="App" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Applies to all projects." Style="{StaticResource TextMuted}" FontSize="14" Margin="0,4,0,26" />
                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Updates…" Command="{Binding UpdatesCommand}" AutomationProperties.AutomationId="UpdatesButton" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Test USB ports… (Ctrl+U)" Command="{Binding OpenHardwareCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding HardwareSummary}" Style="{StaticResource TextMuted}" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
