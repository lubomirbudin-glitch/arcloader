<Window x:Class="Offload.App.LutRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Offload.App"
        Title="Custom LUT rules" Width="820" SizeToContent="Height" MaxHeight="760" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Offload.ico">
    <Window.Resources>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="22,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Custom LUT rules" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Rules are tried from top to bottom, before the automatic camera detection. The first one that matches decides (including “No LUT”)."
                       Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <Button Content="Add rule" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5"
                    AutomationProperties.AutomationId="AddLutRule" />
            <TextBlock Text="{Binding Problem}" Style="{StaticResource ErrorText}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}" AutomationProperties.AutomationId="LutRulesProblem" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="OK" Click="Ok_Click" IsDefault="True" MinWidth="80" Padding="12,5"
                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.AutomationId="LutRulesOk" />
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="12,5" Margin="8,0,0,0" AutomationProperties.AutomationId="LutRulesCancel" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="LutRuleRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- A rule of a newer version: read-only (ruling I3), only the buttons work. -->
                            <TextBlock Text="{Binding FutureText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding IsFuture, Converter={StaticResource BoolToVisible}}" />
                            <Grid Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Source={x:Static local:LutRuleRowViewModel.Kinds}}" SelectedItem="{Binding Kind}"
                                          DisplayMemberPath="Label" AutomationProperties.Name="Match by" />
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"
                                         AutomationProperties.Name="Value" />
                                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" Margin="8,0" />
                                <StackPanel Grid.Column="3">
                                    <ComboBox ItemsSource="{Binding LutChoices}" SelectedItem="{Binding Lut}" DisplayMemberPath="Label"
                                              AutomationProperties.Name="LUT" />
                                    <TextBlock Text="{Binding CustomName}" ToolTip="{Binding CustomPath}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" Visibility="{Binding CustomName, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource RowButton}" Content="↑" Command="{Binding UpCommand}" ToolTip="Move up" />
                                <Button Style="{StaticResource RowButton}" Content="↓" Command="{Binding DownCommand}" ToolTip="Move down" />
                                <Button Style="{StaticResource RowButton}" Content="✕" Command="{Binding RemoveCommand}" ToolTip="Remove rule" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
