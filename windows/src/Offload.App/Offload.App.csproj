<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>mmMover</AssemblyName>
    <RootNamespace>Offload.App</RootNamespace>
    <!-- ThemeMode (Fluent) is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Shared with the Mac version: shared\icon (generated by make_icon.py). -->
    <ApplicationIcon>..\..\..\shared\icon\Offload.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Window icon (title bar, taskbar): pack://application:,,,/Offload.ico -->
    <Resource Include="..\..\..\shared\icon\Offload.ico" Link="Offload.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Offload.Core\Offload.Core.csproj" />
  </ItemGroup>
</Project>
